#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:34
msgid "Widevine install wizard"
msgstr "Widevine-installasjonshjelper"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:48
msgid "Continue"
msgstr "Fortsett"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:75
msgid "Agree"
msgstr "Enig"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:155
msgid "Install Widevine"
msgstr "Installer Widevine"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:162
msgid ""
"Widevine is a plugin that lets you play DRM-protected content, such as music "
"and movies from streaming services."
msgstr ""
"Widevine er en programvareutvidelse som lar deg spille av DRM-beskyttet "
"innhold, for eksempel musikk og filmer fra strømmetjenester."

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:168
msgid ""
"Widevine is not licensed for use with Morph Browser. The plugin will be "
"extracted from a proprietary package. Proceed only if you accept this risk."
msgstr ""
"Widevine er ikke lisensiert for bruk med Morph-nettleseren. "
"Programvareutvidelsen vil bli pakket ut fra en proprietær pakke. Fortsett "
"kun hvis du aksepterer denne risikoen."

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:175
msgid ""
"Installing Widevine requires downloading about 150 MB of data. A stable "
"Internet connection is required and the download may take some time."
msgstr ""
"Å installere Widevine krever at du laster ned omtrent 150 MB med data. Da "
"trengs en stabil nettforbindelse, og nedlastingen kan ta noe tid."

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:201
msgid "License agreement"
msgstr "Lisensavtale"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:208
msgid ""
"The download is complete. Please read the following license agreement "
"carefully before installing Widevine."
msgstr ""
"Nedlastingen er ferdig. Vennligst les følgende lisensavtale nøye før du "
"installerer Widevine."

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:215
msgid "Widevine license"
msgstr "Widevine-lisens"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:243
msgid "Downloading"
msgstr "Laster ned"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:267
msgid "Installing"
msgstr "Installerer"

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:295
msgid "Installation completed."
msgstr "Installasjonen er ferdig."

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:302
msgid "Morph has to be restarted for the changes to take effect."
msgstr "Morph må startes på nytt for at endringene skal tre i kraft."

#: src/app/webbrowser/qml-qt6/widevine/WidevineInstallerWizard.qml:399
msgid "Next"
msgstr "Neste"

